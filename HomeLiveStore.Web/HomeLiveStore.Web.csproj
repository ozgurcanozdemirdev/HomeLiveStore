<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>HomeLiveStore</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HomeLiveStore.Api\HomeLiveStore.Api.csproj" />
  </ItemGroup>

  <!-- The Web host owns its configuration when API controllers are embedded. -->
  <Target Name="ExcludeApiHostSettingsFromWebPublish" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../HomeLiveStore.Api/appsettings.json'));$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../HomeLiveStore.Api/appsettings.Development.json'))" />
    </ItemGroup>
  </Target>

</Project>
